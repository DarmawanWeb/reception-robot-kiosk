# Where the company-profile site lives (launcher "back" link).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Assistant provider: offline (default) | ollama | anthropic | openai
#   offline   answers from the venue FAQ and room list, works without internet
#   ollama    local model through Ollama's native API (keeps the model warm with keep_alive)
#   anthropic Claude Messages API
#   openai    any OpenAI-compatible Chat Completions API (OpenAI, OpenRouter, Groq, vLLM)
AI_PROVIDER=offline
# Model name. Defaults: taksu-asisten (ollama), claude-haiku-4-5-20251001 (anthropic). Required for openai.
AI_MODEL=
# API key for anthropic/openai. Not used by ollama.
AI_API_KEY=
# Base URL override. Ollama default: http://127.0.0.1:11434
AI_BASE_URL=
# Request timeout before falling back to offline answers.
AI_TIMEOUT_MS=15000
# Ollama only: how long the model stays in memory after a request.
AI_KEEP_ALIVE=30m
# Model calls allowed at once; extra visitors get instant offline answers.
AI_MAX_CONCURRENCY=2
# Questions per visitor IP per minute on /api/assistant.
ASSISTANT_RATE_LIMIT=12
