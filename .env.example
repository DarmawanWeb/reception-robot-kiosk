# Where the company-profile site lives (launcher "back" link).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Assistant provider: offline (default, no key needed) | anthropic | openai
#   offline   answers from the venue FAQ and room list, works without internet
#   anthropic Claude Messages API
#   openai    any OpenAI-compatible Chat Completions API (OpenAI, OpenRouter, Groq, Ollama, vLLM)
AI_PROVIDER=offline
# Model name. Defaults to claude-haiku-4-5-20251001 for anthropic; required for openai.
AI_MODEL=
# API key for the provider (not needed for a local Ollama).
AI_API_KEY=
# Base URL override, e.g. http://localhost:11434/v1 for Ollama.
AI_BASE_URL=
# Request timeout in milliseconds before falling back to offline answers.
AI_TIMEOUT_MS=15000
